#!/bin/bash
# Merges upstream's main into this branch, then brings dependencies and Pods up to date with it.
#
#   scripts/fork/sync
#   scripts/fork/sync -h | --help
#
# Refuses to run with uncommitted changes. Stops at a merge conflict: resolve it, commit, and run this again (it then
# finds nothing new to merge and just runs the installs). pnpm install and pod install always run, under the pod lock,
# since upstream adds native files and patches often; pod install's quoting of MARKETING_VERSION is undone.
set -euo pipefail

case "${1:-}" in
  -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;;
  "") ;;
  *) echo "sync: unknown option $1" >&2; exit 64 ;;
esac

repo=$(cd "$(dirname "$0")/../.." && pwd)
cd "$repo"
[[ -z "$(git status --porcelain --untracked-files=no)" ]] || { echo "sync: commit or set aside your changes first" >&2; exit 1; }
git fetch upstream main
before=$(git rev-parse HEAD)
git merge --no-edit upstream/main
echo "merged $(git rev-list --count "$before"..HEAD) commits"
"$repo/scripts/agent/locked" pod -- pnpm install
"$repo/scripts/agent/locked" pod -- sh -c 'cd apps/browser/macos && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 pod install'
sed -i '' 's/MARKETING_VERSION = "\([^"]*\)";/MARKETING_VERSION = \1;/' apps/browser/macos/Ardia.xcodeproj/project.pbxproj
git status --porcelain --untracked-files=no
